---
import type { BodyCatalogueProps } from "./types";

const { catalogueInfo, catalogueImage } = Astro.props as BodyCatalogueProps;
---

<div class="body-catalogue-element">
    <div class="catalogue-image">
        <img src={catalogueImage.img} alt={catalogueImage.alt}>
    </div>
    <div class="catalogue-title"><h1>{catalogueInfo.title}</h1></div>
    <div class="catalogue-text">
        <p>{catalogueInfo.text}</p>
    </div>
    <div class="catalogue-button">
        <button><a href={catalogueInfo.href}>Узнать больше</a></button>
    </div>
</div>